# Dev-режим (npm run dev).
#   fallback — сначала используется реальный бэкенд (npm run server, порт 3000);
#              если он не запущен, запросы /api/* берёт на себя mock API (src/mock/*),
#              иначе Vite-прокси отвечает 500 на все запросы и UI без данных.
#   true     — всегда мок (сервер не нужен);
#   false    — всегда реальный бэкенд (без npm run server все запросы будут 500).
# Переопределение в браузере без пересборки: ?mock=on | ?mock=fallback | ?mock=off.
VITE_MOCK_API=fallback

